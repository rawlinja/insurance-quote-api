{
    "name": "insurance-quote-api",
    "version": "1.0.0",
    "description": "REST API for auto insurance quote applications",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "node build.js",
        "start": "node dist/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rawlinja/insurance-quote-api.git"
    },
    "author": "Jermaine Rawlins <jermaine.rawlins@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rawlinja/insurance-quote-api/issues"
    },
    "homepage": "https://github.com/rawlinja/insurance-quote-api#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.13.2",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "globals": "^17.6.0",
        "prettier": "^3.4.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
        "vite": "^6.4.3",
        "vitest": "^4.1.8"
    },
    "dependencies": {
        "better-sqlite3": "^12.10.0",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.8.5",
        "fastify-type-provider-zod": "^6.1.0",
        "zod": "^4.4.3"
    }
}
